#include "cache.h"

#define IP_TRACKER_COUNT 128
#define PATTERN_COUNT 256
#define PT_INDEX_BITS 8
#define CONF_MAX 3
#define CONF_NEEDED 2
#define EPOCH 256
#define START_DEGREE 4

class IP_ENTRY {
  public:
    unsigned valid : 1;
    unsigned tag : 8;
    unsigned last_cl_addr : 16;
    int last_stride : 7;
    unsigned conf : 2;
    unsigned signature : 12;
    unsigned use_pattern : 1;

    IP_ENTRY () {
        valid = 0;
        tag = 0;
        last_cl_addr = 0;
        last_stride = 0;
        conf = 0;
        signature = 0;
        use_pattern = 0;
    };
};

class PATTERN_ENTRY {
  public:
    unsigned tag : 4;
    int next_stride : 7;
    unsigned conf : 2;

    PATTERN_ENTRY () {
        tag = 0;
        next_stride = 0;
        conf = 0;
    };
};

static SPP_IPT_ENTRY spp_ipt[NUM_CPUS][IPT_ENTRIES];
static SPP_PT_ENTRY  spp_pt[NUM_CPUS][PT_ENTRIES];

// throttling state
static uint32_t spp_degree[NUM_CPUS];
static uint64_t spp_snap_useful[NUM_CPUS], spp_snap_lower[NUM_CPUS];

static uint32_t ip_hash(uint64_t ip)
{
    return (uint32_t)(ip ^ (ip >> 14) ^ (ip >> 28) ^ (ip >> 42));
}

static inline uint16_t spp_next_sig(uint16_t sig, int32_t stride)
{
    return (uint16_t)(((sig << SIG_SHIFT) ^ ((uint32_t)stride & STRIDE_MASK)) & SIG_MASK);
}

static inline uint32_t spp_pt_index(uint16_t sig)
{
    return (sig ^ (sig >> PT_INDEX_BITS)) & (PT_ENTRIES - 1);
}

// stride between two LAST_ADDR_BITS-wide line addresses (sign-extended)
static inline int64_t spp_stride(uint64_t cur, uint64_t last)
{
    int64_t d = (int64_t)((cur - last) & LAST_ADDR_MASK);
    if (d & (1LL << (LAST_ADDR_BITS - 1)))
        d -= (1LL << LAST_ADDR_BITS);
    return d;
}

// accuracy (%) -> degree. See summary for the rationale.
static inline uint32_t spp_degree_for_accuracy(double acc)
{
    if (acc >= 0.80) return 6;
    if (acc >= 0.60) return 4;
    if (acc >= 0.40) return 2;
    return 1;
}

static void spp_touch_lru(uint32_t cpu, int idx)
{
    for (int i = 0; i < IPT_ENTRIES; i++)
        if (spp_ipt[cpu][i].lru < spp_ipt[cpu][idx].lru)
            spp_ipt[cpu][i].lru++;
    spp_ipt[cpu][idx].lru = 0;
}

// ------------ ChampSim hooks --------------
void CACHE::l1d_prefetcher_initialize()
{
    cout << "CPU " << cpu << " L1D Stride Pattern Prefetcher (signature)" << endl;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    update_degree(pf_useful, pf_useless);

    if (type != LOAD)
        return;

    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;
    uint16_t cl_addr_low = (uint16_t)cl_addr;

    uint32_t h = ip_hash(ip);
    unsigned index = h & (IP_TRACKER_COUNT - 1);
    unsigned tag = (h >> 7) & 0xFF;

    if (!trackers[index].valid || trackers[index].tag != tag) {
        trackers[index] = IP_ENTRY();
        trackers[index].valid = 1;
        trackers[index].tag = tag;
        trackers[index].last_cl_addr = cl_addr_low;

        if (!cache_hit)
            miss_new_ip++;
        return;
    }

    SPP_IPT_ENTRY &e = spp_ipt[cpu][idx];
    spp_touch_lru(cpu, idx);

    int64_t stride = (int16_t)(uint16_t)(cl_addr_low - t.last_cl_addr);
    t.last_cl_addr = cl_addr_low;

    if (stride == 0 || stride > 63 || stride < -64) {
        if (!cache_hit)
            miss_unpredicted++;
        return;
    }

    // ------------- train: uniform-stride confidence -------------
    if (stride == e.last_stride) {
        if (e.conf < UNIFORM_CONF_MAX) e.conf++;
    } else {
        e.conf >>= 1;     // a break in the pattern quickly drops "uniform"
    }

    // ------------- train: pattern table (old signature -> this stride) -------------
    if (e.sig != 0) {
        SPP_PT_ENTRY &p = spp_pt[cpu][spp_pt_index(e.sig)];
        if (p.delta == stride) {
            if (p.conf < PT_CONF_MAX) p.conf++;
        } else if (p.conf > 0) {
            p.conf--;
        } else {
            p.delta = (int8_t)stride;
            p.conf = 1;
        }
    }

    e.sig = spp_next_sig(e.sig, (int32_t)stride);
    e.last_stride = (int8_t)stride;
    e.last_addr = cur_addr;
    // ------------- predict -------------
    uint64_t page = addr >> LOG2_PAGE_SIZE;
    int fill = (MSHR.occupancy < (MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;

    if (e.conf >= UNIFORM_THRESH) {
        // Uniform stride (priority)
        for (uint32_t k = 1; k <= degree; k++) {
            uint64_t pf_addr = (uint64_t)((int64_t)cl_addr + stride * (int64_t)k) << LOG2_BLOCK_SIZE;
            if ((pf_addr >> LOG2_PAGE_SIZE) != page)
                break;
            if (prefetch_line(ip, addr, pf_addr, fill, 0))
                spp_pf_uniform[cpu]++;
        }
    } else {
        // Non-uniform: signature lookahead through the pattern table
        uint16_t sig = e.sig;
        int64_t line = (int64_t)cl_addr;
        for (uint32_t k = 1; k <= degree; k++) {
            SPP_PT_ENTRY &p = spp_pt[cpu][spp_pt_index(sig)];
            if (p.conf < PT_CONF_THRESH || p.delta == 0)
                break;
            line += p.delta;
            uint64_t pf_addr = (uint64_t)line << LOG2_BLOCK_SIZE;
            if ((pf_addr >> LOG2_PAGE_SIZE) != page)
                break;
            if (prefetch_line(ip, addr, pf_addr, fill, 0))
                spp_pf_pattern[cpu]++;
            sig = spp_next_sig(sig, p.delta);
        }
    }
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
    return; //metadata_in;
}

void CACHE::l1d_prefetcher_final_stats()
{
    cout << "CPU " << cpu << " L1D SPP final stats" << endl;
    cout << "SPP uniform-stride prefetches: " << spp_pf_uniform[cpu]
         << "  pattern(signature) prefetches: " << spp_pf_pattern[cpu] << endl;
    cout << "SPP degree histogram (accesses):";
    for (int d = 1; d <= MAX_DEGREE; d++)
        if (spp_degree_hist[cpu][d]) cout << " d" << d << "=" << spp_degree_hist[cpu][d];
    cout << endl;
    uint64_t ipt_bits = (uint64_t)IPT_ENTRIES * (1 + IP_TAG_BITS + LAST_ADDR_BITS + STRIDE_BITS + 2 + SIG_BITS + 5);
    uint64_t pt_bits  = (uint64_t)PT_ENTRIES * (STRIDE_BITS + 2);
    cout << "SPP storage: IPT " << ipt_bits << " bits + PT " << pt_bits << " bits = "
         << (ipt_bits + pt_bits) << " bits (" << (ipt_bits + pt_bits) / 8.0 / 1024.0 << " KB)" << endl;
}
