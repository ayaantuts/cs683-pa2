#include "cache.h"

#define IP_TRACKER_COUNT 128
#define PATTERN_COUNT 256
#define HISTORY_LEN 4
#define CONF_MAX 3
#define CONF_NEEDED 2
#define EPOCH 256
#define START_DEGREE 4

class IP_ENTRY {
  public:
    uint64_t ip;
    uint64_t last_cl_addr;
    int64_t last_stride;
    int conf;                       
    int64_t history[HISTORY_LEN];
    bool use_pattern;
    uint32_t lru;

    IP_ENTRY () {
        ip = 0;
        last_cl_addr = 0;
        last_stride = 0;
        conf = 0;
        for (int i=0; i<HISTORY_LEN; i++)
            history[i] = 0;
        use_pattern = false;
        lru = 0;
    };
};

class PATTERN_ENTRY {
  public:
    bool valid;
    int64_t history[HISTORY_LEN];   
    int64_t next_stride;
    int conf;
    uint32_t lru;

    PATTERN_ENTRY () {
        valid = false;
        for (int i=0; i<HISTORY_LEN; i++)
            history[i] = 0;
        next_stride = 0;
        conf = 0;
        lru = 0;
    };
};

static IP_ENTRY trackers[IP_TRACKER_COUNT];
static PATTERN_ENTRY patterns[PATTERN_COUNT];
static unsigned degree = START_DEGREE;

static uint64_t uniform_requests = 0, pattern_requests = 0;
static uint64_t miss_new_ip = 0, miss_predicted = 0, miss_unpredicted = 0;

static void touch_tracker(int index)
{
    for (int i=0; i<IP_TRACKER_COUNT; i++) {
        if (trackers[i].lru < trackers[index].lru)
            trackers[i].lru++;
    }
    trackers[index].lru = 0;
}

static void touch_pattern(int index)
{
    for (int i=0; i<PATTERN_COUNT; i++) {
        if (patterns[i].lru < patterns[index].lru)
            patterns[i].lru++;
    }
    patterns[index].lru = 0;
}

static void push_history(int64_t *history, int64_t stride)
{
    for (int i=0; i<HISTORY_LEN-1; i++)
        history[i] = history[i+1];
    history[HISTORY_LEN-1] = stride;
}

static int find_pattern(int64_t *history)
{
    for (int i=0; i<PATTERN_COUNT; i++) {
        if (!patterns[i].valid)
            continue;

        bool match = true;
        for (int j=0; j<HISTORY_LEN; j++) {
            if (patterns[i].history[j] != history[j])
                match = false;
        }
        if (match)
            return i;
    }
    return -1;
}

static int64_t predict(int64_t *history)
{
    int index = find_pattern(history);
    if (index == -1 || patterns[index].conf < CONF_NEEDED)
        return 0;
    return patterns[index].next_stride;
}

static void learn_pattern(int64_t *history, int64_t stride)
{
    int index = find_pattern(history);

    if (index == -1) {
        for (index=0; index<PATTERN_COUNT; index++) {
            if (patterns[index].lru == (PATTERN_COUNT-1))
                break;
        }
        patterns[index].valid = true;
        for (int j=0; j<HISTORY_LEN; j++)
            patterns[index].history[j] = history[j];
        patterns[index].next_stride = stride;
        patterns[index].conf = 1;
    }
    else if (patterns[index].next_stride == stride) {
        if (patterns[index].conf < CONF_MAX)
            patterns[index].conf++;
    }
    else if (patterns[index].conf > 1)
        patterns[index].conf--;
    else
        patterns[index].next_stride = stride;

    touch_pattern(index);
}

static void update_degree(uint64_t useful, uint64_t useless)
{
    static uint64_t last_useful = 0, last_useless = 0;

    if (useful < last_useful || useless < last_useless) {
        last_useful = useful;
        last_useless = useless;
        return;
    }

    uint64_t good = useful - last_useful;
    uint64_t bad = useless - last_useless;
    if (good + bad < EPOCH)
        return;

    uint64_t accuracy = 100 * good / (good + bad);
    if (accuracy >= 75)
        degree = 8;
    else if (accuracy >= 50)
        degree = 4;
    else if (accuracy >= 25)
        degree = 2;
    else
        degree = 1;

    last_useful = useful;
    last_useless = useless;
}

void CACHE::l1d_prefetcher_initialize()
{
    cout << "CPU " << cpu << " L1D Stride Pattern Prefetcher" << endl;
    for (int i=0; i<IP_TRACKER_COUNT; i++)
        trackers[i].lru = i;
    for (int i=0; i<PATTERN_COUNT; i++)
        patterns[i].lru = i;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    update_degree(pf_useful, pf_useless);

    if (type != LOAD)
        return;

    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

    int index;
    for (index=0; index<IP_TRACKER_COUNT; index++) {
        if (trackers[index].ip == ip)
            break;
    }

    if (index == IP_TRACKER_COUNT) {
        for (index=0; index<IP_TRACKER_COUNT; index++) {
            if (trackers[index].lru == (IP_TRACKER_COUNT-1))
                break;
        }

        uint32_t lru = trackers[index].lru;
        trackers[index] = IP_ENTRY();
        trackers[index].lru = lru;
        trackers[index].ip = ip;
        trackers[index].last_cl_addr = cl_addr;
        touch_tracker(index);

        if (!cache_hit)
            miss_new_ip++;
        return;
    }

    IP_ENTRY &t = trackers[index];

    int64_t stride = (int64_t)(cl_addr - t.last_cl_addr);
    t.last_cl_addr = cl_addr;

    if (stride == 0) {
        if (!cache_hit)
            miss_unpredicted++;
        touch_tracker(index);
        return;
    }

    int64_t guess = predict(t.history);
    bool stride_sure = t.conf >= CONF_NEEDED;
    bool stride_right = (stride == t.last_stride);
    bool pattern_right = (guess == stride);

    if (stride_sure && !stride_right && pattern_right)
        t.use_pattern = true;
    if (stride_sure && stride_right && guess != 0 && !pattern_right)
        t.use_pattern = false;

    if (!cache_hit) {
        if ((stride_sure && stride_right) || pattern_right)
            miss_predicted++;
        else
            miss_unpredicted++;
    }

    if (stride_right) {
        if (t.conf < CONF_MAX)
            t.conf++;
    }
    else {
        t.last_stride = stride;
        t.conf = 1;
    }

    learn_pattern(t.history, stride);
    push_history(t.history, stride);

    bool stride_ready = t.conf >= CONF_NEEDED;
    bool pattern_ready = predict(t.history) != 0;

    if (stride_ready && !(t.use_pattern && pattern_ready)) {
        for (unsigned i=1; i<=degree; i++) {
            uint64_t pf_address = (cl_addr + t.last_stride * i) << LOG2_BLOCK_SIZE;

            if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
                break;

            if (MSHR.occupancy < (MSHR.SIZE>>1))
                prefetch_line(ip, addr, pf_address, FILL_L1, 0);
            else
                prefetch_line(ip, addr, pf_address, FILL_L2, 0);
            uniform_requests++;
        }
    }
    else if (pattern_ready) {
        int64_t history[HISTORY_LEN];
        for (int j=0; j<HISTORY_LEN; j++)
            history[j] = t.history[j];

        uint64_t pf_line = cl_addr;
        for (unsigned i=1; i<=degree; i++) {
            int64_t next = predict(history);
            if (next == 0)
                break;

            pf_line += next;
            uint64_t pf_address = pf_line << LOG2_BLOCK_SIZE;
            if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
                break;

            if (MSHR.occupancy < (MSHR.SIZE>>1))
                prefetch_line(ip, addr, pf_address, FILL_L1, 0);
            else
                prefetch_line(ip, addr, pf_address, FILL_L2, 0);
            pattern_requests++;

            push_history(history, next);
        }
    }

    touch_tracker(index);
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
    return;
}

void CACHE::l1d_prefetcher_final_stats()
{
    cout << "CPU" << cpu << " L1D SPP final stats" << endl;
    cout << "Uniform prefetch requests: " << uniform_requests << endl;
    cout << "Pattern prefetch requests: " << pattern_requests << endl;
    cout << "Final degree: " << degree << endl;
    cout << "L1D load misses by type: " << endl;
    cout << "new or evicted IP: " << miss_new_ip << endl;
    cout << "predicted but not in time:" << miss_predicted << endl;
    cout << "no stride pattern: " << miss_unpredicted << endl;
}